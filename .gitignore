**/*.rs.bk
# Keep the workspace dependency graph reproducible for contracts, tooling, and CI.
**/*.orig
**/*.bk
**/node_modules
**/.next/
**/out/
**/dist/
**/build/
**/*.log
**/.DS_Store
Thumbs.db
**/.env
**/.env.local
**/.env.*.local
**/secret*
**/id_*
**/*.pem
**/*.key
**/*.p12
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
coverage/
# Soroban test-environment snapshot artifacts
**/test_snapshots/
